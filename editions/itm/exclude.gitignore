# ── Domain modules (switched off in edition.json; not shipped either) ───────
system/mcp-server/src/metis_mcp/tools/dhis2.py
system/mcp-server/src/metis_mcp/tools/course_builder.py
system/mcp-server/src/metis_mcp/tools/background_packs.py

# ── Background packs: "no background" — every layer is built from the
#    researcher's own documents, never pre-seeded ─────────────────────────────
backgrounds/
knowledge/library/
knowledge/course-template/
knowledge/domains/
knowledge/courses/

# ── Development tooling: the release pipeline, audits, the dev-only checks ──
# tools/ itself ships: the scheduler, the database layer and the Windows
# autostart run scripts from it. Only the scripts written for one subject, or
# for the two-computer development setup, stay behind.
system/release/
tools/mine_hat_references.py
tools/harvest_backfill.py
tools/bulk_add_to_library.py
tools/migrate_risk_mapping_record.py
tools/verify_library_feeds.py
tools/sync_runbook.py
tools/test_routing_regression.py
tools/metis-sync-db.py
tools/metis-sync-cleanup.py
tools/base-shell/
tools/pdf-meta-extractor/
graphify-knowledge/
docs/DOMAIN-PACKS.md
docs/INDEXING-GUIDE.md
docs/RAG-ARCHITECTURE.md
