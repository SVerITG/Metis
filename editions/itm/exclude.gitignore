system/install/index-ph.sh
system/install/windows/icon-previews/
system/install/windows/icon_designer.py
system/install/windows/icon_studio.py

# ── Tests: the suite stays in development; the edition ships the install
#    doctor's own consistency test and the pack test ───────────────────────────
tests/**
!tests/unit/test_essentials.py

# ── CI of the full build: its Docker images and cross-distro gate. The edition
#    carries its own workflow (overlay .github/workflows/itm-smoke.yml) ───────
.github/workflows/docker-publish.yml
.github/workflows/release-gate.yml
.github/workflows/tests.yml

# ── Developer-only scripts and snapshots ─────────────────────────────────────
system/app-py/before.json
system/app-py/after.json
system/mcp-server/index_missing.py
system/metis-autotest.py
tools/merge_corpus_aliases.py

# The owner's two-computer daily routine; colleagues get morning-briefing.md.
system/config/scheduled/metis-daily-update.md
