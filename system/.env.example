# Metis Research Cortex — Environment variables template
# Copy this file to .env and fill in your values:
#   cp system/.env.example system/.env
# Never commit .env to git — it contains secret keys.
# Note: WSL interop is disabled on some systems — Windows env vars may not be
#       visible to WSL processes. Always set these directly in this file.

# ── Anthropic API key ─────────────────────────────────────────────────────────
# Get your key at: https://console.anthropic.com → API Keys → Create Key
# Format: sk-ant-api03-...
#
# NEEDED FOR:     automated morning briefs, scheduled news scans, dashboard AI
# NOT NEEDED FOR: using Metis through Claude Desktop or Claude Code (your subscription)
#
# You can use Metis without this key — interactive features work on your
# Claude subscription. The key only enables features that run unattended.
ANTHROPIC_API_KEY=

# ── Optional — Zotero integration ─────────────────────────────────────────────
# Required only if you use /librarian with Zotero sync.
# Get your key at: https://www.zotero.org/settings/keys
ZOTERO_API_KEY=your-zotero-api-key-here
ZOTERO_USER_ID=your-zotero-user-id-here
# ZOTERO_GROUP_ID=your-zotero-group-id-here
# ZOTERO_ROOT=/home/<username>/Zotero/storage

# ── Optional — Extra AI providers ─────────────────────────────────────────────
# Gemini — used by some agents as a secondary model
# GEMINI_API_KEY=your-gemini-api-key-here

# Hugging Face — used for local model downloads (Whisper, etc.)
# HF_API_TOKEN=your-huggingface-token-here

# ── Optional — Voice transcription ────────────────────────────────────────────
# Whisper model size: tiny | base | small | medium | large
# Larger = more accurate but slower. "base" is a good default.
# METIS_WHISPER_MODEL=base

# ── Optional — Dashboard port ─────────────────────────────────────────────────
# Change if 8080 is already in use on your machine.
# DASHBOARD_PORT=8080

# ---------------------------------------------------------------------------
# Library acquisition — getting the PDF for a paper
# ---------------------------------------------------------------------------
# Metis tries open access first (publisher DOI routes, Unpaywall, PubMed
# Central). Only if that finds nothing does it try your institution.
#
# LIBRARY_PROXY_TEMPLATE — your institution's link-resolver, with {url} where the
# target goes. Two common shapes:
#     OpenAthens : https://go.openathens.net/redirector/<domain>?url={url}
#     EZproxy    : https://login.ezproxy.<domain>/login?url={url}
# ITM Antwerp uses the OpenAthens form. NOTE: the OpenAthens redirector rejects
# doi.org targets (HTTP 400), so Metis resolves the DOI to the publisher's own
# URL via Crossref first.
LIBRARY_PROXY_TEMPLATE=

# LIBRARY_PROXY_COOKIE — OPTIONAL. A background process cannot complete a
# federated SSO login (OpenAthens/Shibboleth, especially with MFA), so without
# this the institutional route reaches a "please sign in" page and Metis reports
# that honestly rather than pretending. Pasting a session cookie from your
# logged-in browser lets the automated download work for as long as that session
# lasts. Leave empty to rely on the one-click "GET VIA INSTITUTION" link
# instead, which opens in your browser where the session already exists.
LIBRARY_PROXY_COOKIE=

# UNPAYWALL_EMAIL — Unpaywall requires a contact address in its API calls. Any
# address you are willing to send to that service; defaults to a local
# placeholder if unset.
UNPAYWALL_EMAIL=
